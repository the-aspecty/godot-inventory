; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Inventory System"
config/tags=PackedStringArray("component", "system")
config/features=PackedStringArray("4.4", "C#", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InventoryManager="*res://Examples/inventory_manager.tscn"

[dotnet]

project/assembly_name="Inventory System"

[editor_plugins]

enabled=PackedStringArray("res://addons/inventory_system/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
